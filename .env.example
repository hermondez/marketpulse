# Copia este archivo a .env y rellena tus valores. NUNCA subas .env a Git.
# --- Snowflake (usuario de servicio para ingesta/alertas/health) ---
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=MARKETPULSE_SVC
SNOWFLAKE_PASSWORD=cambia_esto
SNOWFLAKE_ROLE=MARKETPULSE_LOADER
SNOWFLAKE_WAREHOUSE=MARKETPULSE_WH
SNOWFLAKE_DATABASE=MARKETPULSE
# --- Snowflake (usuario de solo lectura para "Pregunta a tus datos") ---
SNOWFLAKE_READER_USER=MARKETPULSE_ASK
SNOWFLAKE_READER_PASSWORD=cambia_esto
SNOWFLAKE_READER_ROLE=MARKETPULSE_READER
# --- dbt ---
DBT_TARGET=dev
DBT_SCHEMA_PREFIX=DEV
# --- Fuente de precios: yfinance | stooq ---
PRICE_SOURCE=yfinance
# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-reemplazar
TELEGRAM_CHAT_ID=123456789
# --- LLM: cortex | openai | anthropic ---
LLM_PROVIDER=cortex
CORTEX_MODEL=mistral-large2
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# --- Carga: insert (defecto, sin stage) | write_pandas (PUT+COPY, requiere salida a S3/Azure/GCS) ---
SNOWFLAKE_LOAD_METHOD=insert
