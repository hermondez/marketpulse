# Copia a .streamlit/secrets.toml (local, ignorado por git) o pega en
# Streamlit Cloud > App settings > Secrets. Claves en el nivel raíz (sin [secciones]).

# --- Snowflake: SOLO el usuario/rol de lectura (el dashboard no necesita más) ---
SNOWFLAKE_ACCOUNT = "XXXXXXX-XX00000"        # no secreto
SNOWFLAKE_WAREHOUSE = "MARKETPULSE_WH"       # no secreto
SNOWFLAKE_DATABASE = "MARKETPULSE"           # no secreto
SNOWFLAKE_READER_USER = "MARKETPULSE_ASK"    # no secreto
SNOWFLAKE_READER_ROLE = "MARKETPULSE_READER" # no secreto
SNOWFLAKE_READER_PASSWORD = "cambia_esto"    # SECRETO
MARTS_SCHEMA = "MARTS"                       # no secreto

# --- Pregunta a tus datos (opcional: sin APP_ASK_PASSWORD la página queda desactivada) ---
APP_ASK_PASSWORD = "cambia_esto"             # SECRETO
APP_ASK_MAX_QUESTIONS = "10"
LLM_PROVIDER = "openai"                      # cortex | openai | anthropic
LLM_MODEL = "gpt-4o-mini"
LLM_BASE_URL = "https://api.openai.com/v1"
LLM_API_KEY = "sk-..."                       # SECRETO
